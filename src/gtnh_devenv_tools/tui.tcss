#filter {
    height: 3;
}

#repos, #pack, #reviews, #mine, #org, #tools {
    height: 1fr;
}

#detail {
    height: auto;
    max-height: 18;
    padding: 0 1;
    border-top: solid $primary;
}

ConfirmScreen, MenuScreen {
    align: center middle;
}

#dialog-info {
    height: auto;
    margin-bottom: 1;
}

#menu {
    height: auto;
    max-height: 12;
    margin-bottom: 1;
    border: none;
}

#dialog {
    width: 80;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#dialog-head {
    height: auto;
    margin-bottom: 1;
}

#dialog-title {
    width: 1fr;
    text-style: bold;
}

#close {
    width: 3;
    content-align: center middle;
    color: $text-muted;
}

#close:hover {
    background: $error;
    color: $text;
}

#dialog-body {
    height: auto;
    max-height: 20;
    margin-bottom: 1;
}

#dialog-buttons {
    height: auto;
    align-horizontal: right;
}

#dialog-buttons Button {
    margin-left: 2;
}

#spark-status {
    height: 1;
    padding: 0 1;
    background: $boost;
}

#spark-input {
    height: 3;
}

#spark-recent {
    height: auto;
    max-height: 22;
    border: none;
}

#spark-report {
    height: 1fr;
    border: none;
}

#spark-hint {
    height: 1;
    padding: 0 1;
}
