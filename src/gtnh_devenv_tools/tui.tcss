#filter {
    height: 3;
}

#repos, #pack {
    height: 1fr;
}

#detail {
    height: auto;
    max-height: 14;
    padding: 0 1;
    border-top: solid $primary;
}

ConfirmScreen, RepoMenu {
    align: center middle;
}

#menu {
    height: auto;
    max-height: 12;
    margin-bottom: 1;
    border: none;
}

#dialog {
    width: 80;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#dialog-head {
    height: auto;
    margin-bottom: 1;
}

#dialog-title {
    width: 1fr;
    text-style: bold;
}

#close {
    width: 3;
    content-align: center middle;
    color: $text-muted;
}

#close:hover {
    background: $error;
    color: $text;
}

#dialog-body {
    height: auto;
    max-height: 20;
    margin-bottom: 1;
}
